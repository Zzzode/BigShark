# Local stage-6 measurement evidence (raw driver CSVs/artifacts; summaries go
# in docs/plans, not here)
artifacts/stage6/

# Local flop class library builds (per-class schema-v3 artifacts and manifest;
# the measurements are summarized in docs/design/gto-engine.md)
artifacts/flop-library/
artifacts/flop-library-25bb/
artifacts/flop-library-3p/
artifacts/flop-library-50bb/
artifacts/flop-library-100bb/
artifacts/flop-library-3p-10bb/

# Local preflop profile builds (schema-v2 artifacts and manifest; the
# measurements are summarized in docs/design/gto-engine.md)
artifacts/preflop-profile/

# Local N-way preflop profile builds (RFC 0010; same schema-v2 format)
artifacts/preflop-profile-3way/

# RFC 0012: packed mmap binary libraries and parallel-training verification
# output. The .bin is a derived acceleration layer; the SQLite artifacts
# remain canonical. Never commit files under artifacts/.
artifacts/flop-library-25bb.bin
artifacts/flop-library-25bb.bin.sha256
artifacts/ac1-16w/

# Catch-all: never commit anything under the top-level artifacts/ directory
# (the specific patterns above document the expected contents; this guards
# against stray files). Anchored to the repo root so engine/src/artifacts/
# source files are not affected.
/artifacts/
