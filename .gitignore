# Local stage-6 measurement evidence (raw driver CSVs/artifacts; summaries go
# in docs/plans, not here)
artifacts/stage6/

# Local flop class library builds (per-class schema-v3 artifacts and manifest;
# the measurements are summarized in docs/design/gto-engine.md)
artifacts/flop-library/
artifacts/flop-library-25bb/
artifacts/flop-library-3p/
artifacts/flop-library-50bb/
artifacts/flop-library-100bb/
artifacts/flop-library-3p-10bb/
artifacts/flop-library-4p/

# Local preflop profile builds (schema-v2 artifacts and manifest; the
# measurements are summarized in docs/design/gto-engine.md)
artifacts/preflop-profile/

# Local N-way preflop profile builds (RFC 0010 family; RFC 0037 unified
# 100 BB set: cap 1 for 3..6 seats). The 3-seat 10 BB cap-0 profile was
# retired 2026-10-26 and must not be rebuilt into artifacts/.
artifacts/preflop-profile-3way-100bb/
artifacts/preflop-profile-4way/
artifacts/preflop-profile-5way/
artifacts/preflop-profile-6way/

# RFC 0012: packed mmap binary libraries and parallel-training verification
# output. The .bin is a derived acceleration layer; the SQLite artifacts
# remain canonical. Never commit files under artifacts/.
artifacts/flop-library-25bb.bin
artifacts/flop-library-25bb.bin.sha256
# The narrow early ac1-16w library was retired 2026-10-26; the catch-all
# below keeps any rebuilt copy untracked.

# Catch-all: never commit anything under the top-level artifacts/ directory
# (the specific patterns above document the expected contents; this guards
# against stray files). Anchored to the repo root so engine/src/artifacts/
# source files are not affected.
/artifacts/

# Local-only materials (internal references, never publish)
/local/

# RFC 0045 G2 campaign working state (BSWARM03 checkpoints and per-shard
# CSVs are scratch; the aggregated evidence of record is copied to
# docs/plans/ablation/rfc0045-g2-campaign.csv).
/rfc45-ckpt/
/rfc45-run2/

# RFC 0047 S3 R240 river census working state. Per-batch partials, salvaged
# rows, orchestrator logs, and superseded timing/smoke CSVs are scratch; the
# certified 240-group evidence of record is committed under
# docs/plans/ablation/rfc0047/s3/r240-census/ (same pattern as RFC 0045).
/docs/plans/ablation/rfc0047/s3/salvaged-partials/
/docs/plans/ablation/rfc0047/s3/*.log
/docs/plans/ablation/rfc0047/s3/online-river-*.csv
/docs/plans/ablation/rfc0047/s3/batch-*.csv
